{
  "name": "arc-diagrams",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:offline": "vite build --config vite.config.offline.ts",
    "postbuild:offline": "node scripts/publish-canvas.mjs",
    "publish:canvas": "node scripts/publish-canvas.mjs",
    "probe": "node scripts/probe-layout.mjs --serve",
    "lint:text": "node scripts/lint-canvas-text.mjs",
    "cmp:baseline": "node scripts/cmp-baseline.mjs",
    "baseline": "node scripts/cmp-baseline.mjs --write",
    "deliver": "node scripts/deliver.mjs",
    "gate": "npm run build && npm run build:offline && npm run lint:text && npm run probe -- --theme light && npm run probe -- --theme dark && npm run probe:ux -- --theme light && npm run probe:ux -- --theme dark && npm run export && npm run deliver && npm run cmp:baseline",
    "export": "node scripts/export-statics.mjs --serve exports",
    "probe:ux": "node scripts/probe-ux.mjs --serve"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xyflow/react": "^12.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "html-to-image": "^1.11.11"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3",
    "typescript": "~5.6",
    "vite": "^6",
    "vite-plugin-singlefile": "^2.0.3",
    "playwright": "^1.49.0"
  }
}
