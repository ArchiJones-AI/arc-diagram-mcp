      ],
      "steps": [
        { "n": 1, "text": "The member presses play and the **Netflix player** sends a start request through the **API edge**.", "nodes": ["player", "gateway"], "edges": ["start"] },
        { "n": 2, "text": "The **API edge** routes the request to **playback control**.", "nodes": ["gateway", "playback"], "edges": ["route-play"] },
        { "n": 3, "text": "**Playback control** checks the member plan, rights, and concurrent-stream conditions with **entitlement**.", "nodes": ["playback", "rights"], "edges": ["check-rights"] },
        { "n": 4, "text": "**Playback control** asks **source steering** for an appropriate content source.", "nodes": ["playback", "source-control"], "edges": ["choose-source"] },
        { "n": 5, "text": "**Source steering** returns the playable representations and content sources to the **Netflix player**.", "nodes": ["source-control", "player"], "edges": ["return-sources"] },
        { "n": 6, "text": "The **Netflix player** requests media segments from an **embedded OCA** close to the member.", "nodes": ["player", "embedded-cache"], "edges": ["segment-request"] },
        { "n": 7, "text": "The **embedded OCA** serves audio and video directly to the **Netflix player** over HTTP.", "nodes": ["embedded-cache", "player"], "edges": ["video-stream"] },
        { "n": 8, "text": "The **embedded OCA** reports health and load so **source steering** can incorporate current delivery conditions into later decisions.", "nodes": ["embedded-cache", "source-control"], "edges": ["health-feedback"] }
      ]
    }
  ]
}
